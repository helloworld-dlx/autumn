{
  "version": 1,
  "devices": {
    "desk_lamp": {
      "label": "书桌灯（示例）",
      "entity_id": "light.replace_me",
      "read": ["state", "brightness"],
      "risk": "low",
      "confirm": false,
      "actions": {
        "on": {"service": "turn_on"},
        "off": {"service": "turn_off"}
      }
    },
    "room_temperature": {
      "label": "室温（示例）",
      "entity_id": "sensor.replace_me",
      "read": ["state", "unit_of_measurement"],
      "risk": "low",
      "confirm": false,
      "actions": {}
    },
    "room_fan": {
      "label": "房间风扇（示例）",
      "entity_id": "fan.replace_me",
      "read": ["state", "percentage"],
      "risk": "low",
      "confirm": false,
      "actions": {
        "on": {"service": "turn_on"},
        "off": {"service": "turn_off"},
        "set_speed": {"service": "set_percentage"}
      }
    },
    "room_speaker": {
      "label": "房间音箱（示例）",
      "entity_id": "media_player.replace_me",
      "read": ["state", "volume_level", "media_title"],
      "risk": "low",
      "confirm": false,
      "actions": {
        "play": {"service": "media_play"},
        "pause": {"service": "media_pause"},
        "set_volume": {"service": "volume_set"}
      }
    }
  }
}
