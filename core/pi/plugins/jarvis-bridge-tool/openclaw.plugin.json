{
  "id": "jarvis-bridge-tool",
  "name": "Jarvis Bridge Tool",
  "description": "Sixteen existing Bridge-backed tools plus autumn_nodes, a read-only observation tool for the Pi Node Registry at 127.0.0.1:27901. autumn_nodes exposes only current node presence and declared capabilities; CAPABILITY != AUTHORIZATION.",
  "version": "0.3.1",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "contracts": {
    "tools": [
      "autumn_nodes",
      "jarvis_ping",
      "jarvis_system_info",
      "jarvis_system_status",
      "jarvis_list_directory",
      "jarvis_search_files",
      "jarvis_program_list",
      "jarvis_program_run",
      "worker_submit",
      "worker_status",
      "worker_cancel",
      "worker_result",
      "worker_authorization_request",
      "worker_authorization_approve",
      "worker_control_status",
      "worker_emergency_stop",
      "worker_resume"
    ]
  }
}
